#
# The default /tmp (half of RAM) is too small for MindTheGapps (~1.1 GB)
on fs
    mount tmpfs tmpfs /tmp remount size=85%

# No misc partition on the factory partition table
on post-fs
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/etc/gtaxl-misc.sh
