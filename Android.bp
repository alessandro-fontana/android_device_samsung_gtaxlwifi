// Power: required by the perfmgr-lineage option
prebuilt_etc {
    name: "powerhint.json",
    src: "configs/power/powerhint.json",
    vendor: true,
}

// Camera: required by the libcamera provider option
prebuilt_etc {
    name: "libcamera_camera_hal.yaml",
    src: "configs/camera/camera_hal.yaml",
    filename: "camera_hal.yaml",
    relative_install_path: "libcamera",
    vendor: true,
}

prebuilt_etc {
    name: "gtaxlwifi-camera-features.xml",
    src: "configs/camera/gtaxlwifi-camera-features.xml",
    relative_install_path: "permissions",
    vendor: true,
}

// Doze: no always-on display
runtime_resource_overlay {
    name: "GtaxlNoAodOverlay",
    resource_dirs: ["rro/GtaxlNoAodOverlay/res"],
    manifest: "rro/GtaxlNoAodOverlay/AndroidManifest.xml",
    vendor: true,
    overrides: ["AodDefaultOnOverlay"],
}

// Wi-Fi: PNO with the screen off
runtime_resource_overlay {
    name: "GtaxlWifiOverlay",
    resource_dirs: ["rro/GtaxlWifiOverlay/res"],
    manifest: "rro/GtaxlWifiOverlay/AndroidManifest.xml",
    vendor: true,
}

// Camera tuning: libcamera looks for <sensor>.yaml before uncalibrated.yaml
prebuilt_etc {
    name: "libcamera_ipa_simple_s5k4h5yc.yaml",
    src: "configs/camera/tuning/s5k4h5yc.yaml",
    filename: "s5k4h5yc.yaml",
    sub_dir: "libcamera/ipa/simple",
    vendor: true,
}

prebuilt_etc {
    name: "libcamera_ipa_simple_sr259.yaml",
    src: "configs/camera/tuning/sr259.yaml",
    filename: "sr259.yaml",
    sub_dir: "libcamera/ipa/simple",
    vendor: true,
}
