#

modalias_handling enabled

# Touch HAL
/sys/devices/platform/soc@0/13840000.i2c/i2c-2/2-0049	key_swap	0660	system	system
/sys/devices/platform/soc@0/13840000.i2c/i2c-2/2-0049	key_disable	0660	system	system

# GPS power, written by gpsd through /data/vendor/gps/nstdby
/sys/devices/platform/gps/rfkill/rfkill*	state	0660	gps	system

# Camera flash
/sys/devices/platform/soc@0/13870000.i2c/i2c-4/4-0049/sm5703-flash.*/leds/white:flash	brightness	0664	cameraserver	camera
/sys/devices/platform/soc@0/13870000.i2c/i2c-4/4-0049/sm5703-flash.*/leds/white:flash	flash_strobe	0664	cameraserver	camera
/sys/devices/platform/soc@0/13870000.i2c/i2c-4/4-0049/sm5703-flash.*/leds/white:flash	flash_brightness	0664	cameraserver	camera
/sys/devices/platform/soc@0/13870000.i2c/i2c-4/4-0049/sm5703-flash.*/leds/white:flash	flash_timeout	0664	cameraserver	camera

# Backlight, written by the composer
/sys/devices/platform/soc@0/14800000.dsi/14800000.dsi.0/backlight/*	brightness	0664	system	system

# Charging control
/sys/devices/platform/soc@0/13870000.i2c/i2c-4/4-0049/sm5703-charger.*/power_supply/sm5703-charger	charging_enabled	0664	system	system

# exynos-drm's render node: minigbm takes the first node that opens, which
# must be panfrost (renderD129). Assumes exynos-drm always gets renderD128.
/dev/dri/renderD128	0000	root	root
