# libcamera AIDL camera provider (hal_camera_default)

# libcamera enumerates /sys/bus/media/devices and reads uevent of the linked nodes
type sysfs_media_gtaxl, sysfs_type, fs_type;
allow hal_camera_default sysfs_media_gtaxl:dir r_dir_perms;
allow hal_camera_default sysfs_media_gtaxl:lnk_file read;
allow hal_camera_default sysfs_media_gtaxl:file r_file_perms;

# Intermediate and JPEG buffers are allocated in-process via gralloc (minigbm)
allow hal_camera_default hal_graphics_mapper_service:service_manager find;

# The minigbm mapper (gbm_mesa) opens the GPU node in every process that loads it
gpu_access(hal_camera_default)
gpu_access(cameraserver)
gpu_access(mediaserver)

# Preview buffers return with an acquire fence created by the composer
allow hal_camera_default hal_graphics_composer_default:fd use;

# Mesa asks Panfrost which GPU context priorities it may use, and the kernel
# checks CAP_SYS_NICE, which the provider's .rc gives: the normal priority
# is enough
dontaudit hal_camera_default self:capability sys_nice;
