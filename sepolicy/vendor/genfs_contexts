# Display and GPU
genfscon sysfs /devices/platform/soc@0/14800000.dsi/14800000.dsi.0/backlight u:object_r:sysfs_leds:s0
genfscon sysfs /devices/platform/exynos-drm u:object_r:sysfs_gpu:s0
genfscon sysfs /devices/platform/soc@0/11400000.gpu u:object_r:sysfs_gpu:s0

# USB
genfscon sysfs /devices/platform/soc@0/soc@0:usb@13600000/13600000.usb/udc u:object_r:sysfs_udc:s0

# Audio
genfscon sysfs /devices/platform/sound/sound u:object_r:sysfs_sound:s0

# Camera
genfscon sysfs /bus/media u:object_r:sysfs_media_gtaxl:s0
# Whole I2C controllers, since the i2c-N number depends on which buses are enabled
genfscon sysfs /devices/platform/soc@0/14420000.csis u:object_r:sysfs_media_gtaxl:s0
genfscon sysfs /devices/platform/soc@0/138c0000.i2c u:object_r:sysfs_media_gtaxl:s0
genfscon sysfs /devices/platform/soc@0/138a0000.i2c u:object_r:sysfs_media_gtaxl:s0
genfscon sysfs /devices/platform/soc@0/138b0000.i2c u:object_r:sysfs_media_gtaxl:s0
# Prefix match: the sm5703-flash.N.auto id is not stable
genfscon sysfs /devices/platform/soc@0/13870000.i2c/i2c-4/4-0049/sm5703-flash u:object_r:sysfs_camera_flash_gtaxl:s0

# GPS
genfscon sysfs /devices/platform/gps/rfkill u:object_r:sysfs_gps:s0
