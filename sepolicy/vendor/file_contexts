# Partitions (by-name links from androidboot.boot_devices)
/dev/block/by-name/RECOVERY   u:object_r:recovery_block_device:s0
/dev/block/by-name/CACHE      u:object_r:cache_block_device:s0
/dev/block/by-name/USERDATA   u:object_r:userdata_block_device:s0
/dev/block/by-name/metadata   u:object_r:metadata_block_device:s0
/dev/block/by-name/misc       u:object_r:misc_block_device:s0
/dev/block/by-name/super      u:object_r:super_block_device:s0

# GPS (BCM4752 on ttySAC0)
/dev/ttySAC0   u:object_r:gnss_device:s0
/data/vendor/gps(/.*)?   u:object_r:gps_vendor_data_file:s0
/vendor/bin/hw/gpsd   u:object_r:gpsd_exec:s0
/vendor/bin/hw/android\.hardware\.gnss-service\.gtaxlwifi   u:object_r:hal_gnss_default_exec:s0
/vendor/bin/gtaxl-gps-rfkill\.sh   u:object_r:gtaxl_gps_rfkill_exec:s0

# Camera: AOSP labels only /dev/video*
/dev/media[0-9]*         u:object_r:video_device:s0
/dev/v4l-subdev[0-9]*    u:object_r:video_device:s0
